---
import "../styles/tokens.css";
import { url } from "../lib/base";

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url("escudo.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,500&family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} — ArchivoDragón</title>
    <script is:inline>
      // Aplicado antes del render para evitar flash de tema incorrecto.
      // "blanco" es el default — se guarda igual que los otros para que el
      // picker sepa cuál marcar como activo.
      const saved = localStorage.getItem("theme") || "blanco";
      document.documentElement.setAttribute("data-theme", saved);
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={url("")} class="wordmark">
          <img src={url("escudo.svg")} alt="Escudo de Defensores de Belgrano" class="header-escudo" />
          ARCHIVO<span class="rojo">DRAGÓN</span>
        </a>
        <nav id="site-nav">
          <a href={url("")}>Inicio</a>
          <a href={url("noticias")}>Noticias</a>
          <a href={url("canciones")}>Cancionero</a>
          <a href={url("partidos")}>Partidos</a>
          <a href={url("historias")}>Historias</a>
        </nav>
        <div class="theme-picker" role="group" aria-label="Elegir color del sitio">
          <button class="swatch swatch-blanco" data-theme-value="blanco" aria-label="Fondo blanco"></button>
          <button class="swatch swatch-negro" data-theme-value="negro" aria-label="Fondo negro"></button>
          <button class="swatch swatch-rojo" data-theme-value="rojo" aria-label="Fondo rojo"></button>
        </div>
        <button
          id="nav-toggle"
          class="nav-toggle"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>ArchivoDragón es un proyecto de hinchas sin fines de lucro. Todo el material cita y enlaza su fuente original.</p>
      </div>
    </footer>
    <script is:inline>
      const swatches = document.querySelectorAll(".swatch");
      function markActive() {
        const current = document.documentElement.getAttribute("data-theme");
        swatches.forEach((s) => s.classList.toggle("is-active", s.dataset.themeValue === current));
      }
      swatches.forEach((s) => {
        s.addEventListener("click", () => {
          const value = s.dataset.themeValue;
          document.documentElement.setAttribute("data-theme", value);
          localStorage.setItem("theme", value);
          markActive();
        });
      });
      markActive();

      const navToggle = document.getElementById("nav-toggle");
      const siteNav = document.getElementById("site-nav");
      navToggle.addEventListener("click", () => {
        const isOpen = siteNav.classList.toggle("is-open");
        navToggle.classList.toggle("is-open", isOpen);
        navToggle.setAttribute("aria-expanded", String(isOpen));
        navToggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
      });
      siteNav.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", () => {
          siteNav.classList.remove("is-open");
          navToggle.classList.remove("is-open");
          navToggle.setAttribute("aria-expanded", "false");
          navToggle.setAttribute("aria-label", "Abrir menú");
        });
      });
    </script>
    <style>
      .site-header {
        border-bottom: 3px solid var(--rojo);
        background: var(--paper);
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-2) var(--space-3);
      }
      .wordmark {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 20px;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .wordmark .rojo { color: var(--rojo); }
      .header-escudo { height: 28px; width: auto; display: block; }
      nav { display: flex; gap: var(--space-3); font-size: 14px; font-weight: 600; flex: 1; }
      nav a { color: var(--ink-soft); text-decoration: none; }
      nav a:hover { color: var(--rojo); }
      .theme-picker { display: flex; gap: 8px; align-items: center; }
      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 32px;
        height: 32px;
        padding: 0;
        border: none;
        background: transparent;
        cursor: pointer;
      }
      .nav-toggle span {
        display: block;
        width: 100%;
        height: 2px;
        background: var(--ink);
        transition: transform 150ms ease-out, opacity 150ms ease-out;
      }
      .nav-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
      .nav-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      @media (max-width: 720px) {
        .header-inner { flex-wrap: wrap; }
        .nav-toggle { display: flex; order: 1; margin-left: auto; }
        .theme-picker { order: 2; }
        nav {
          order: 3;
          flex-basis: 100%;
          flex-direction: column;
          gap: 0;
          max-height: 0;
          overflow: hidden;
          transition: max-height 200ms ease-out;
        }
        nav.is-open {
          max-height: 320px;
          border-top: 1px solid var(--rule);
          margin-top: var(--space-2);
        }
        nav a {
          padding: var(--space-2) 0;
          border-bottom: 1px solid var(--rule);
        }
      }
      .swatch {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        cursor: pointer;
        border: 2px solid var(--rule);
        padding: 0;
        transition: transform 100ms ease-out, border-color 100ms ease-out;
      }
      .swatch:hover { transform: scale(1.12); }
      .swatch.is-active { border-color: var(--rojo); }
      .swatch-blanco { background: #ffffff; }
      .swatch-negro { background: #0d0d0d; }
      .swatch-rojo { background: #8f1912; }
      .site-footer {
        border-top: 1px solid var(--rule);
        margin-top: var(--space-5);
        padding: var(--space-3) 0;
        font-size: 13px;
        color: var(--ink-faint);
      }
    </style>
  </body>
</html>
