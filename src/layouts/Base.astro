---
import "../styles/tokens.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,500&family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} — ArchivoDragón</title>
    <script is:inline>
      // Aplicado antes del render para evitar flash de tema incorrecto.
      const saved = localStorage.getItem("theme");
      if (saved) document.documentElement.setAttribute("data-theme", saved);
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="wordmark">ARCHIVO<span class="rojo">DRAGÓN</span></a>
        <nav>
          <a href="/">Inicio</a>
          <a href="/noticias">Noticias</a>
          <a href="/canciones">Cancionero</a>
          <a href="/partidos">Partidos</a>
          <a href="/historias">Historias</a>
          <a href="/stats">Stats</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" aria-label="Cambiar tema claro/oscuro">◐</button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>ArchivoDragón es un proyecto de hinchas sin fines de lucro. Todo el material cita y enlaza su fuente original.</p>
      </div>
    </footer>
    <script is:inline>
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme");
        const next = current === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      });
    </script>
    <style>
      .site-header {
        border-bottom: 3px solid var(--rojo);
        background: var(--paper);
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-2) var(--space-3);
      }
      .wordmark {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 20px;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
      }
      .wordmark .rojo { color: var(--rojo); }
      nav { display: flex; gap: var(--space-3); font-size: 14px; flex: 1; }
      nav a { color: var(--ink-soft); text-decoration: none; }
      nav a:hover { color: var(--rojo); }
      .theme-toggle {
        background: transparent;
        border: 1px solid var(--rule);
        color: var(--ink-soft);
        border-radius: var(--radius-sm);
        width: 32px;
        height: 32px;
        cursor: pointer;
        font-size: 15px;
        line-height: 1;
      }
      .theme-toggle:hover { border-color: var(--rojo); color: var(--rojo); }
      .site-footer {
        border-top: 1px solid var(--rule);
        margin-top: var(--space-5);
        padding: var(--space-3) 0;
        font-size: 13px;
        color: var(--ink-faint);
      }
    </style>
  </body>
</html>
