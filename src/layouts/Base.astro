---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — ArchivoDragón</title>
  </head>
  <body>
    <header>
      <h1><a href="/">ARCHIVO<span class="rojo">DRAGÓN</span></a></h1>
      <nav>
        <a href="/">Inicio</a>
        <a href="/noticias">Noticias</a>
        <a href="/canciones">Cancionero</a>
        <a href="/partidos">Partidos</a>
        <a href="/historias">Historias</a>
        <a href="/stats">Stats</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>ArchivoDragón es un proyecto de hinchas sin fines de lucro. Todo el material cita y enlaza su fuente original.</p>
    </footer>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 900px; margin: 0 auto; padding: 0 1rem; }
      header { display: flex; align-items: baseline; gap: 1.5rem; border-bottom: 3px solid #900; padding: 1rem 0; }
      header h1 { font-size: 1.4rem; }
      header a { text-decoration: none; color: inherit; }
      .rojo { color: #900; }
      nav { display: flex; gap: 1rem; font-size: 0.9rem; }
      footer { border-top: 1px solid #ccc; margin-top: 2rem; padding: 1rem 0; font-size: 0.8rem; color: #666; }
    </style>
  </body>
</html>
