---
// Gateada hasta RICH_VIEWS_THRESHOLD piezas (decisión T1). Feature bandera de
// etapa 2 según el design doc: navegar por fecha y "revivir un día". Necesita
// el schema v2 de partido (rival/resultado/torneo/formación) ya diseñado en
// content.config.ts. TODO: selector de fecha real; hoy es un placeholder.
import Base from "../layouts/Base.astro";
import { getAllPieces, richViewsUnlocked, RICH_VIEWS_THRESHOLD } from "../lib/archive";

const pieces = await getAllPieces();
const unlocked = await richViewsUnlocked();
---
<Base title="Máquina del tiempo">
  <div class="wrap">
    <span class="kicker">En construcción</span>
    <h1>Máquina del tiempo</h1>
    {!unlocked ? (
      <p class="notice">
        Esta vista se activa con {RICH_VIEWS_THRESHOLD} piezas curadas (hoy: {pieces.length}).
      </p>
    ) : (
      <p>TODO: selector de fecha navegable.</p>
    )}
  </div>
  <style>
    h1 { font-family: var(--font-display); font-size: clamp(28px, 5vw, 40px); margin: var(--space-2) 0 var(--space-3); }
  </style>
</Base>
