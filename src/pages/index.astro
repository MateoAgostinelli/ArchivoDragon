---
import Base from "../layouts/Base.astro";
import SourceCite from "../components/SourceCite.astro";
import { getAllPieces, sortByDate, richViewsUnlocked, RICH_VIEWS_THRESHOLD } from "../lib/archive";

const pieces = await getAllPieces();
const recent = sortByDate(pieces).reverse().slice(0, 6);
const unlocked = await richViewsUnlocked();
const sources = new Set(pieces.map((p) => p.data.source.name));
---
<Base title="Inicio">
  <section class="hero">
    <h2>120 años del Dragón, en un solo lugar.</h2>
    <p>
      Noticias de diario, historias, canciones y partidos — juntados de blogs,
      hemerotecas y memoria de hinchas. Cada pieza cita su fuente original.
    </p>
    <div class="stats">
      <span><b>{pieces.length}</b> piezas archivadas</span>
      <span><b>{sources.size}</b> fuentes citadas</span>
    </div>
  </section>

  {!unlocked && (
    <p class="notice">
      La línea de tiempo, la máquina del tiempo y "tal día como hoy" se activan
      al llegar a {RICH_VIEWS_THRESHOLD} piezas curadas ({pieces.length}/{RICH_VIEWS_THRESHOLD} hoy).
      <a href="#aportar">¿Tenés material del Dragón?</a>
    </p>
  )}

  <h3>Últimas piezas agregadas</h3>
  <div class="grid">
    {recent.map((p) => (
      <article class="card">
        <span class={`tipo tipo-${p.collection}`}>{p.collection}</span>
        <h4><a href={`/pieza/${p.collection}/${p.id}`}>{p.data.title}</a></h4>
        <div class="fecha">{p.data.date_display ?? p.data.date}</div>
        <SourceCite source={p.data.source} />
      </article>
    ))}
  </div>

  <p id="aportar">
    ¿Tenés material del Dragón? <a href="#">Contanos acá</a> (link al Google Form — TODO).
  </p>

  <style>
    .hero { border: 1px solid #ddd; padding: 1.2rem; margin: 1.5rem 0; }
    .stats { display: flex; gap: 1.5rem; margin-top: 0.6rem; font-size: 0.9rem; }
    .notice { background: #fff8e6; border: 1px solid #e6c200; padding: 0.8rem; font-size: 0.9rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
    .card { border: 1px solid #ccc; padding: 0.8rem; }
    .tipo { font-size: 0.7rem; text-transform: uppercase; background: #900; color: #fff; padding: 1px 6px; border-radius: 2px; }
    .fecha { color: #777; font-size: 0.85rem; margin: 0.3rem 0; }
  </style>
</Base>
