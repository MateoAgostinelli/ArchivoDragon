---
// Cita de fuente: siempre visible, en cada pieza, sin excepción — es el
// requisito central del proyecto (ver DESIGN.md / docs/designs/archivodragon.md).
interface Props {
  source: { name: string; url?: string; archived_url?: string };
}
const { source } = Astro.props;
const archivedLink =
  source.archived_url && source.archived_url !== "pending" ? source.archived_url : null;
---
<p class="fuente">
  <span class="label">Fuente:</span> {source.name}
  {source.url && <> — <a href={source.url} rel="noopener">original ↗</a></>}
  {archivedLink && <> — <a href={archivedLink} rel="noopener">copia archivada</a></>}
  {source.archived_url === "pending" && <span class="pending"> (archivado pendiente)</span>}
</p>
<style>
  .fuente {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-faint);
    border-top: 1px dashed var(--rule);
    padding-top: var(--space-1);
    margin-top: var(--space-2);
  }
  .fuente .label { color: var(--ink-soft); }
  /* position+z-index: cuando esta cita vive dentro de una tarjeta con
     "stretched link" (ver song-card en [type]/index.astro), estos links
     necesitan quedar por encima del ::after que cubre toda la tarjeta,
     para poder clickearse de forma independiente. */
  .fuente a { color: var(--rojo); text-decoration: underline; position: relative; z-index: 1; }
  .pending { font-style: italic; }
</style>
